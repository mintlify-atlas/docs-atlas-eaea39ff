  "keyFeatures": [
    "End-to-end reactivity between Phoenix LiveView and Vue.js",
    "Server-side rendering (SSR) for Vue components",
    "Efficient props diffing with JSON Patch",
    "~VUE sigil as alternative LiveView DSL",
    "Phoenix Streams support with efficient patches",
    "Comprehensive form handling with useLiveForm",
    "File upload composable with useLiveUpload",
    "One-line installation via Igniter",
    "Lazy-loading Vue components",
    "Tailwind CSS support"
  ],
  "publicApiSurface": [
    "LiveVue.vue/1 - Phoenix component for rendering Vue components",
    "~VUE sigil - Alternative DSL for Vue component rendering",
    "createLiveVue() - Initialize LiveVue app",
    "getHooks() - Get Phoenix LiveView hooks",
    "useLiveVue() - Access LiveView instance from Vue",
    "useLiveEvent() - Listen for server-pushed events",
    "useLiveNavigation() - Programmatic navigation",
    "useLiveForm() - Server-side form validation",
    "useLiveUpload() - File upload integration",
    "useEventReply() - Handle reply responses",
    "useLiveConnection() - Connection status",
    "useField() - Individual form field",
    "useArrayField() - Array form field",
    "Link component - Navigation component"
